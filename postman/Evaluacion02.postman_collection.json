{
  "info": {
    "name": "Clinica - Evaluacion 02",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Ejecutar en orden en una base de demostracion. Si repites la coleccion, cambia codigo, username y correo para evitar duplicados. Captura IDs y versiones reales. DELETE desactiva conservando las relaciones."
  },
  "auth": {
    "type": "basic",
    "basic": [
      {
        "key": "username",
        "value": "{{admin}}",
        "type": "string"
      },
      {
        "key": "password",
        "value": "{{password}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "admin",
      "value": "admin"
    },
    {
      "key": "password",
      "value": "Demo123!"
    },
    {
      "key": "rolId",
      "value": "1"
    },
    {
      "key": "rolVersion",
      "value": "0"
    },
    {
      "key": "usuarioId",
      "value": "1"
    },
    {
      "key": "usuarioVersion",
      "value": "0"
    }
  ],
  "item": [
    {
      "name": "Crear rol",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/admin/roles",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"codigo\": \"POSTMAN_ROL\",\n  \"nombre\": \"Consulta Postman\",\n  \"descripcion\": \"Rol de demostracion\",\n  \"activo\": true,\n  \"permisos\": [\n    \"PACIENTES\"\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "if ([200,201].includes(pm.response.code)) { const x=pm.response.json(); pm.collectionVariables.set(\"rolId\",x.id); pm.collectionVariables.set(\"rolVersion\",x.version); }"
            ]
          }
        }
      ]
    },
    {
      "name": "Listar roles",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/admin/roles"
      },
